import numpy as np
import wave
from pathlib import Path
import time

# ============================================================
# GEOLOGICAL MILLE-FEUILLE
# 1 minute prototype
#
# 「時間区間ごとに音を作る」のではなく、
# 「構造階層ごとに音を作り、それらを全時間にわたって重ねる」
#
# 512 structural strata
# 8 hierarchical temporal scales
#
# Python 3 + NumPy only
# ============================================================

SR = 44100
DURATION = 60.0

LAYERS = 512
PARTIALS = 4

# 一度に計算する時間
CHUNK_SECONDS = 0.5

# 一度に計算する地層数
LAYER_BLOCK = 32

SEED = 190326

OUTPUT = Path("geological_millefeuille_1minute.wav")


# ============================================================
# STRUCTURAL HIERARCHY
#
# これは「1分を区切る」のではない。
# 各層が1分間ずっと存在し、それぞれ違う時間スケールを持つ。
# ============================================================

SCALE_PERIODS = np.array([
    52.0,   # 巨大構造
    27.0,
    13.0,
    6.3,
    3.1,
    1.47,
    0.71,
    0.34,   # 微細構造
], dtype=np.float64)

# 各階層に何層置くか
SCALE_COUNTS = np.array([
    4,
    8,
    16,
    32,
    64,
    96,
    128,
    164,
])

assert SCALE_COUNTS.sum() == LAYERS


# ============================================================
# PARAMETERS
# ============================================================

rng = np.random.default_rng(SEED)

scale_id = np.repeat(
    np.arange(len(SCALE_PERIODS)),
    SCALE_COUNTS
)

center_period = SCALE_PERIODS[scale_id]

# 同じ階層でも完全には同じ周期にしない
period = center_period * rng.uniform(
    0.72,
    1.34,
    LAYERS
)

# 音域
base_frequency = (
    28.0
    * (14000.0 / 28.0)
    ** rng.random(LAYERS)
)

# 幾何学的位相
phase0 = rng.uniform(
    0.0,
    2.0 * np.pi,
    LAYERS
)

phase1 = rng.uniform(
    0.0,
    2.0 * np.pi,
    LAYERS
)

phase2 = rng.uniform(
    0.0,
    2.0 * np.pi,
    LAYERS
)

# 移動速度
motion_speed = (
    0.05
    + 2.8 * rng.random(LAYERS)
)

# 幾何学次数
geometry_order = rng.integers(
    2,
    15,
    LAYERS
)

# 幾何学タイプ
geometry_type = rng.integers(
    0,
    7,
    LAYERS
)

# ステレオ初期位置
pan0 = rng.uniform(
    -0.95,
    0.95,
    LAYERS
)

pan_depth = rng.uniform(
    0.10,
    0.95,
    LAYERS
)

# 層が現れたり埋没したりする境界値
visibility_threshold = rng.uniform(
    0.15,
    0.80,
    LAYERS
)

# 各層の質量
amplitude = (
    rng.uniform(
        0.35,
        1.0,
        LAYERS
    )
    / np.sqrt(LAYERS)
)

# 非整数倍音
ratio1 = rng.uniform(
    1.07,
    1.91,
    LAYERS
)

ratio2 = rng.uniform(
    1.93,
    3.87,
    LAYERS
)

ratio3 = rng.uniform(
    3.91,
    7.61,
    LAYERS
)


# ============================================================
# GEOMETRY
# ============================================================

def make_geometry(t, indices):

    p = period[indices]
    ph0 = phase0[indices]
    ph1 = phase1[indices]

    order = geometry_order[indices]
    typ = geometry_type[indices]

    speed = motion_speed[indices]

    # --------------------------------------------------------
    # 各地層固有の時間
    # --------------------------------------------------------

    clock = (
        2.0 * np.pi
        * t[None, :]
        / p[:, None]
        + ph0[:, None]
    )

    # --------------------------------------------------------
    # 移動
    # --------------------------------------------------------

    movement = (
        clock
        + 0.43
        * np.sin(
            speed[:, None] * t[None, :]
            + ph1[:, None]
        )
    )

    # --------------------------------------------------------
    # 基礎幾何学
    # --------------------------------------------------------

    a = np.sin(
        order[:, None]
        * movement
    )

    b = np.cos(
        (order[:, None] + 0.37)
        * movement
        + ph1[:, None]
    )

    # --------------------------------------------------------
    # 7種類の連続的な幾何変形
    # --------------------------------------------------------

    g0 = 0.5 + 0.5 * np.sin(movement)

    g1 = 0.5 + 0.5 * np.sin(
        movement + 0.65 * a
    )

    g2 = 0.5 + 0.5 * np.cos(
        a + b
    )

    g3 = 0.5 + 0.5 * (
        np.sin(movement)
        * np.cos(b)
    )

    g4 = 0.5 + 0.5 * np.sin(
        movement + a * b
    )

    g5 = 0.5 + 0.5 * np.cos(
        movement
        + 0.5 * a
        + 0.3 * b
    )

    g6 = 0.5 + 0.5 * np.sin(
        movement
        + 0.2 * np.sin(3.0 * b)
    )

    # 型によって選択
    geometry = np.choose(
        typ[:, None],
        [
            g0,
            g1,
            g2,
            g3,
            g4,
            g5,
            g6,
        ]
    )

    # --------------------------------------------------------
    # 折れ目
    # --------------------------------------------------------

    fold = (
        0.35
        + 0.65
        * np.abs(
            np.sin(
                2.7 * movement
                + 1.3 * b
            )
        )
    )

    return movement, geometry, fold


# ============================================================
# RENDER STRUCTURAL LAYERS
# ============================================================

def render_layers(t, indices, global_phase):

    movement, geometry, fold = make_geometry(
        t,
        indices
    )

    f0 = base_frequency[indices]

    # --------------------------------------------------------
    # 幾何学 → 周波数
    # --------------------------------------------------------

    frequency = (
        f0[:, None]
        * (
            0.74
            + 0.58 * geometry
        )
    )

    # 巨大な全体構造から微細な偏位を受ける
    frequency *= (
        1.0
        + 0.025
        * np.sin(
            global_phase[None, :]
            + phase2[indices, None]
        )
    )

    # --------------------------------------------------------
    # 地層の可視性
    # --------------------------------------------------------

    visible = np.clip(
        (
            geometry
            - visibility_threshold[indices, None]
        ) / 0.58,
        0.0,
        1.0
    )

    # 折れ目が音響密度を増加させる
    density = (
        0.24
        + 0.76 * fold
    )

    amp = (
        amplitude[indices, None]
        * visible
        * density
    )

    # --------------------------------------------------------
    # 位相
    #
    # 1つの地層の中から複数の非整数倍音を生成。
    # これが「内部の細胞」になる。
    # --------------------------------------------------------

    phase = (
        2.0 * np.pi
        * frequency
        * t[None, :]
        + 0.22 * movement
        + 0.17 * geometry
    )

    signal = np.sin(
        phase
    )

    if PARTIALS >= 2:

        signal += (
            0.43
            * np.sin(
                phase
                * ratio1[indices, None]
                + 0.29 * fold
            )
        )

    if PARTIALS >= 3:

        signal += (
            0.23
            * np.sin(
                phase
                * ratio2[indices, None]
                - 0.21 * movement
            )
        )

    if PARTIALS >= 4:

        signal += (
            0.11
            * np.sin(
                phase
                * ratio3[indices, None]
                + 0.17 * geometry
            )
        )

    signal *= amp

    # --------------------------------------------------------
    # 空間移動
    # --------------------------------------------------------

    pan = np.clip(
        pan0[indices, None]
        + pan_depth[indices, None]
        * 0.55
        * np.sin(
            movement * 0.31
            + geometry
        )
        + 0.16
        * (geometry - 0.5),
        -1.0,
        1.0
    )

    left = (
        signal
        * np.sqrt(
            0.5 * (1.0 - pan)
        )
    )

    right = (
        signal
        * np.sqrt(
            0.5 * (1.0 + pan)
        )
    )

    return (
        left.sum(axis=0),
        right.sum(axis=0)
    )


# ============================================================
# MAIN
# ============================================================

def main():

    total_samples = int(
        SR * DURATION
    )

    chunk_samples = int(
        SR * CHUNK_SECONDS
    )

    left = np.zeros(
        total_samples,
        dtype=np.float32
    )

    right = np.zeros(
        total_samples,
        dtype=np.float32
    )

    started = time.time()

    for start in range(
        0,
        total_samples,
        chunk_samples
    ):

        end = min(
            start + chunk_samples,
            total_samples
        )

        n = end - start

        t = (
            np.arange(
                start,
                end,
                dtype=np.float64
            )
            / SR
        )

        # ----------------------------------------------------
        # 60秒全体を一周するマクロ構造
        #
        # これは「セクション」ではない。
        # 全地層に薄く作用する巨大な変形場。
        # ----------------------------------------------------

        global_phase = (
            2.0
            * np.pi
            * t
            / DURATION
        )

        mix_l = np.zeros(
            n,
            dtype=np.float64
        )

        mix_r = np.zeros(
            n,
            dtype=np.float64
        )

        # ----------------------------------------------------
        # 地層を小ブロックで処理
        # ----------------------------------------------------

        for b0 in range(
            0,
            LAYERS,
            LAYER_BLOCK
        ):

            b1 = min(
                b0 + LAYER_BLOCK,
                LAYERS
            )

            indices = np.arange(
                b0,
                b1
            )

            l, r = render_layers(
                t,
                indices,
                global_phase
            )

            mix_l += l
            mix_r += r

        # ----------------------------------------------------
        # 地層の堆積感を保ったまま穏やかにまとめる
        # ----------------------------------------------------

        mix_l = np.tanh(
            mix_l * 1.35
        )

        mix_r = np.tanh(
            mix_r * 1.35
        )

        left[start:end] = (
            mix_l * 0.24
        ).astype(np.float32)

        right[start:end] = (
            mix_r * 0.24
        ).astype(np.float32)

        progress = (
            end / total_samples
        )

        elapsed = (
            time.time()
            - started
        )

        print(
            f"{progress*100:6.2f}%"
            f"   elapsed {elapsed/60:6.1f} min",
            flush=True
        )

    # ========================================================
    # FINALIZATION
    # ========================================================

    # DC offset
    left -= left.mean()
    right -= right.mean()

    # 全体正規化
    peak = max(
        float(np.max(np.abs(left))),
        float(np.max(np.abs(right))),
        1e-12
    )

    left /= peak * 1.03
    right /= peak * 1.03

    # 16-bit PCM
    stereo = np.column_stack(
        (left, right)
    )

    pcm = np.int16(
        np.clip(
            stereo,
            -1.0,
            1.0
        )
        * 32767
    )

    # ========================================================
    # WAV
    # ========================================================

    with wave.open(
        str(OUTPUT),
        "wb"
    ) as wf:

        wf.setnchannels(2)
        wf.setsampwidth(2)
        wf.setframerate(SR)

        wf.writeframes(
            pcm.tobytes()
        )

    print()
    print("FINISHED")
    print(
        "output:",
        OUTPUT.resolve()
    )
    print(
        "layers:",
        LAYERS
    )
    print(
        "partials per layer:",
        PARTIALS
    )
    print(
        "duration:",
        DURATION,
        "seconds"
    )


if __name__ == "__main__":
    main()
